// ───────────── hms: laboratory ─────────────

enum SampleType {
  BLOOD
  URINE
  STOOL
  SWAB
  OTHER

  @@schema("hms")
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH

  @@schema("hms")
}

enum LabOrderStatus {
