  orderedBy      String?        @map("ordered_by") @db.Uuid
  status         LabOrderStatus @default(ORDERED)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  collectedAt    DateTime?      @map("collected_at") @db.Timestamptz(3)
  releasedAt     DateTime?      @map("released_at") @db.Timestamptz(3)
  releasedBy     String?        @map("released_by") @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  branch       Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])
  patient      Patient        @relation(fields: [tenantId, patientId], references: [tenantId, id])
  consultation Consultation?  @relation(fields: [tenantId, consultationId], references: [tenantId, id])
  invoice      Invoice?       @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  items        LabOrderItem[]

