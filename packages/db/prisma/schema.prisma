  flag        ResultFlag?
  notes       String?
  resultedBy  String?     @map("resulted_by") @db.Uuid
  resultedAt  DateTime?   @map("resulted_at") @db.Timestamptz(3)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  order  LabOrder @relation(fields: [tenantId, orderId], references: [tenantId, id])
  test   LabTest  @relation(fields: [tenantId, testId], references: [tenantId, id])

  @@index([tenantId, orderId])
  @@map("lab_order_items")
