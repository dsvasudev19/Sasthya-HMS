// ───────────── hms: pharmacy ─────────────

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  OTHER

  @@schema("hms")
}

enum StockMoveType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  EXPIRY
  RETURN
  TRANSFER_OUT
  TRANSFER_IN

  @@schema("hms")
}

model Medicine {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  genericName  String?      @map("generic_name")
  form         MedicineForm @default(TABLET)
  strength     String?
  unitLabel    String       @default("tablet") @map("unit_label")
  // Units in one pack (10 tablets to a strip). Stock and price are per unit; the counter can sell whole packs or loose units.
  packSize     Int          @default(1) @map("pack_size")
  packLabel    String       @default("strip") @map("pack_label")
  pricePaise   Int          @map("price_paise")
  reorderLevel Int          @default(10) @map("reorder_level")
  gstPercent   Int          @default(12) @map("gst_percent")
