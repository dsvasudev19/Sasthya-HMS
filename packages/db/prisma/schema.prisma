  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  branch   Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id])
  medicine Medicine   @relation(fields: [tenantId, medicineId], references: [tenantId, id])
  batch    StockBatch @relation(fields: [tenantId, batchId], references: [tenantId, id])

  @@index([tenantId, branchId, medicineId, createdAt])
  @@map("stock_movements")
