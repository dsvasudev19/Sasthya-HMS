// Two schemas, nothing in "public":
//   platform - global control-plane data (no tenant filter)
//   hms      - tenant-owned data; every table has tenant_id and row-level security (added in the migration SQL)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "hms"]
}

// ───────────── platform schema ─────────────

enum TenantKind {
  HOSPITAL
  CLINIC
  // A standalone medical store: pharmacy workspace only, no appointments or consultations.
  PHARMACY

  @@schema("platform")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED

  @@schema("platform")
}

enum PlanCode {
  PAY_PER_PATIENT
  STARTER
  UNLIMITED

  @@schema("platform")
}

model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  slug            String       @unique
  name            String
  kind            TenantKind
  status          TenantStatus @default(TRIAL)
  planCode        PlanCode     @default(PAY_PER_PATIENT) @map("plan_code")
  timezone        String       @default("Asia/Kolkata")
  shard           Int          @default(0)
  trialEndsAt     DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  suspendedReason String?      @map("suspended_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships            TenantMembership[]
  patients               Patient[]
  appointments           Appointment[]
  auditLogs              AuditLog[]
  cardPlans              HealthCardPlan[]
  cards                  HealthCard[]
  cardMembers            HealthCardMember[]
  cardSubs               CardSubscription[]
  benefitUsage           BenefitUsage[]
  patientLinks           PatientLink[]
  feeItems               FeeItem[]
  counters               Counter[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  dailyClosings          DailyClosing[]
  consultations          Consultation[]
  prescriptionItems      PrescriptionItem[]
  medicines              Medicine[]
  stockBatches           StockBatch[]
  stockMovements         StockMovement[]
  dispenses              Dispense[]
  dispenseLines          DispenseLine[]
  labTests               LabTest[]
  labOrders              LabOrder[]
  labOrderItems          LabOrderItem[]
  messages               Message[]
  tenantSettings         TenantSetting[]
  platformInvoices       PlatformInvoice[]
  refunds                Refund[]
  paymentLinks           PaymentLink[]
  tenantRoles            TenantRole[]
  tenantPolicies         TenantPolicy[]
  staffBranches          StaffBranch[]
  branches               Branch[]
  doctorProfiles         DoctorProfile[]
  doctorSchedules        DoctorSchedule[]
  doctorLeaves           DoctorLeave[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceipts          GoodsReceipt[]
  goodsReceiptLines      GoodsReceiptLine[]
  supplierPayments       SupplierPayment[]
  saleReturns            SaleReturn[]
  saleReturnLines        SaleReturnLine[]
  posShifts              PosShift[]
  patientDocuments       PatientDocument[]
  teleSessions           TeleSession[]
  userAccessOverrides    UserAccessOverride[]
  tasks                  Task[]
  wards                  Ward[]
  beds                   Bed[]
  admissions             Admission[]
  bedStays               BedStay[]
  admissionNotes         AdmissionNote[]
  payers                 Payer[]
  policies               PatientPolicy[]
  claims                 Claim[]
  claimEvents            ClaimEvent[]
  theatres               Theatre[]
  surgeries              Surgery[]
  erVisits               ErVisit[]
  shifts                 Shift[]
  attendance             Attendance[]
  leaveRequests          LeaveRequest[]
  doctorShares           DoctorShare[]
  doctorPayouts          DoctorPayout[]
  feedback               Feedback[]
  reportSchedules        ReportSchedule[]
  reportRuns             ReportRun[]
  security               TenantSecurity?
  tenantFeatureOverrides TenantFeatureOverride[]
  profile                TenantProfile?
  agreements             TenantAgreement[]
  tenantLimits           TenantLimits[]

  @@map("tenants")
  @@schema("platform")
}

// A person known to the platform (verified by phone OTP). One identity can belong to many tenants.
model Identity {
  id                 String   @id @default(uuid(7)) @db.Uuid
  phone              String   @unique
  fullName           String?  @map("full_name")
  // Staff sign in with phone + password; patients use phone OTP and have no password.
  passwordHash       String?  @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships         TenantMembership[]
  appointments        Appointment[]
  patientLinks        PatientLink[]
  consultations       Consultation[]
  platformAdmins      PlatformAdmin[]
  refreshTokens       RefreshToken[]
  mfa                 IdentityMfa?
  staffBranches       StaffBranch[]
  userAccessOverrides UserAccessOverride[]

  @@map("identities")
  @@schema("platform")
}

model TenantMembership {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  // Key of a role defined by the hospital (see TenantRole); built-in keys are OWNER, ADMIN, DOCTOR and so on.
  role       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  identity Identity   @relation(fields: [identityId], references: [id])
  roleDef  TenantRole @relation(fields: [tenantId, role], references: [tenantId, key])

  @@unique([tenantId, identityId, role])
  @@index([identityId])
  @@map("tenant_memberships")
  @@schema("platform")
}

// ───────────── hms schema (tenant-owned, RLS) ─────────────

enum Gender {
  FEMALE
  MALE
  OTHER

  @@schema("hms")
}

model Patient {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  patientNo         String    @map("patient_no")
  identityId        String?   @map("identity_id") @db.Uuid
  fullName          String    @map("full_name")
  gender            Gender?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  phone             String?
  // Language for automated messages (en, hi). Reminders are skipped when the patient has opted out.
  language          String    @default("en")
  reminderOptOut    Boolean   @default(false) @map("reminder_opt_out")
  // Ayushman Bharat Digital Mission health ID: 14 digits, and the optional ABHA address (name@abdm).
  abhaNumber        String?   @map("abha_number")
  abhaAddress       String?   @map("abha_address")
  // Standing clinical facts shown on every consultation: allergies and long-term conditions matter more than any single visit.
  bloodGroup        String?   @map("blood_group")
  allergies         String[]  @default([])
  chronicConditions String[]  @default([]) @map("chronic_conditions")
  clinicalNotes     String?   @map("clinical_notes")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  documents      PatientDocument[]
  tasks          Task[]
  admissions     Admission[]
  policies       PatientPolicy[]
  claims         Claim[]
  surgeries      Surgery[]
  erVisits       ErVisit[]
  feedback       Feedback[]
  appointments   Appointment[]
  ownedCards     HealthCard[]      @relation("CardOwner")
  cardMembership HealthCardMember?
  benefitUsage   BenefitUsage[]
  invoices       Invoice[]
  consultations  Consultation[]
  dispenses      Dispense[]
  labOrders      LabOrder[]
  messages       Message[]

  @@unique([tenantId, id])
  @@unique([tenantId, patientNo])
  @@index([tenantId, phone])
  @@map("patients")
  @@schema("hms")
}

model AuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  actorIdentityId String?  @map("actor_identity_id") @db.Uuid
  action          String
  entity          String
  entityId        String?  @map("entity_id")
  meta            Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
  @@schema("hms")
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@schema("hms")
}

enum VisitChannel {
  IN_PERSON
  TELE

  @@schema("hms")
}

model Appointment {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  branchId    String            @map("branch_id") @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  doctorId    String?           @map("doctor_id") @db.Uuid
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz(3)
  tokenNo     Int?              @map("token_no")
  channel     VisitChannel      @default(IN_PERSON)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  // True when a health card covered this visit (consultation fee is waived).
  feeWaived   Boolean           @default(false) @map("fee_waived")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  usage        BenefitUsage?
  invoice      Invoice?
  consultation Consultation?
  tele         TeleSession?
  documents    PatientDocument[]
  // Composite FK: a patient from another tenant can never be referenced.
  patient      Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor       Identity?         @relation(fields: [doctorId], references: [id])
  branch       Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, branchId, scheduledAt])
  @@index([tenantId, doctorId, scheduledAt])
  @@map("appointments")
  @@schema("hms")
}

// ───────────── platform: patient app support ─────────────

// Links a phone-verified identity to its patient record inside a hospital (logical link, no cross-tenant read).
model PatientLink {
  id         String   @id @default(uuid(7)) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([identityId, tenantId])
  @@map("patient_links")
  @@schema("platform")
}

model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
  @@schema("platform")
}

// ───────────── hms: health cards ─────────────

enum CardType {
  INDIVIDUAL
  FAMILY

  @@schema("hms")
}

enum CardStatus {
  ACTIVE
  BLOCKED

  @@schema("hms")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  INSURANCE

  @@schema("hms")
}

model HealthCardPlan {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  type           CardType
  issueFeePaise  Int      @map("issue_fee_paise")
  planPricePaise Int      @map("plan_price_paise")
  durationMonths Int      @default(6) @map("duration_months")
  maxMembers     Int      @default(1) @map("max_members")
  inPersonVisits Int      @default(3) @map("in_person_visits")
  teleVisits     Int      @default(2) @map("tele_visits")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  cards  HealthCard[]

  @@unique([tenantId, id])
  @@map("health_card_plans")
  @@schema("hms")
}

// A card is issued once and never expires; care plans (subscriptions) run on it for a period.
model HealthCard {
  id             String     @id @default(uuid(7)) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  cardNo         String     @map("card_no")
  planId         String     @map("plan_id") @db.Uuid
  ownerPatientId String     @map("owner_patient_id") @db.Uuid
  status         CardStatus @default(ACTIVE)
  issueFeePaise  Int        @map("issue_fee_paise")
  issuedAt       DateTime   @default(now()) @map("issued_at") @db.Timestamptz(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  plan          HealthCardPlan     @relation(fields: [tenantId, planId], references: [tenantId, id])
  owner         Patient            @relation("CardOwner", fields: [tenantId, ownerPatientId], references: [tenantId, id])
  members       HealthCardMember[]
  subscriptions CardSubscription[]

  @@unique([tenantId, id])
  @@unique([tenantId, cardNo])
  @@index([tenantId, ownerPatientId])
  @@map("health_cards")
  @@schema("hms")
}

// One patient can be on at most one card per hospital.
model HealthCardMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  card    HealthCard @relation(fields: [tenantId, cardId], references: [tenantId, id])
  patient Patient    @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, patientId])
  @@index([tenantId, cardId])
  @@map("health_card_members")
  @@schema("hms")
}

model CardSubscription {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  cardId        String        @map("card_id") @db.Uuid
  startsAt      DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime      @map("ends_at") @db.Timestamptz(3)
  pricePaise    Int           @map("price_paise")
  paymentMethod PaymentMethod @map("payment_method")
  // Limits are copied from the plan at purchase, so later plan edits never change a running period.
  inPersonLimit Int           @map("in_person_limit")
  teleLimit     Int           @map("tele_limit")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  card   HealthCard     @relation(fields: [tenantId, cardId], references: [tenantId, id])
  usages BenefitUsage[]

  @@unique([tenantId, id])
  @@index([tenantId, cardId, endsAt])
  @@map("card_subscriptions")
  @@schema("hms")
}

model BenefitUsage {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  appointmentId  String       @map("appointment_id") @db.Uuid
  channel        VisitChannel
  usedAt         DateTime     @default(now()) @map("used_at") @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  subscription CardSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id])
  patient      Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  appointment  Appointment      @relation(fields: [tenantId, appointmentId], references: [tenantId, id])

  @@unique([tenantId, appointmentId])
  @@index([tenantId, subscriptionId, channel])
  @@map("benefit_usage")
  @@schema("hms")
}

// ───────────── hms: billing ─────────────

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  VOID

  @@schema("hms")
}

enum InvoiceSource {
  MANUAL
  IPD
  CONSULTATION
  HEALTH_CARD
  PHARMACY
  LAB

  @@schema("hms")
}

enum LineKind {
  CONSULTATION
  CARD_ISSUE
  CARD_PLAN
  SERVICE
  MEDICINE
  LAB
  OTHER

  @@schema("hms")
}

// Price list per hospital (paise). Consultation fees come from here.
model FeeItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String
  name       String
  kind       LineKind
  pricePaise Int      @map("price_paise")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("fee_items")
  @@schema("hms")
}

// Race-free per-tenant sequences (patient numbers, invoice numbers, daily tokens).
model Counter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("counters")
  @@schema("hms")
}

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  invoiceNo     String        @map("invoice_no")
  // Optional: a counter sale to a walk-in customer has no patient record.
  patientId     String?       @map("patient_id") @db.Uuid
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  appointmentId String?       @map("appointment_id") @db.Uuid
  source        InvoiceSource @default(MANUAL)
  status        InvoiceStatus @default(UNPAID)
  subtotalPaise Int           @map("subtotal_paise")
  discountPaise Int           @default(0) @map("discount_paise")
  totalPaise    Int           @map("total_paise")
  // GST contained in the total (prices are tax-inclusive).
  taxPaise      Int           @default(0) @map("tax_paise")
  paidPaise     Int           @default(0) @map("paid_paise")
  refundedPaise Int           @default(0) @map("refunded_paise")
  note          String?
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  patient      Patient?      @relation(fields: [tenantId, patientId], references: [tenantId, id])
  appointment  Appointment?  @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  lines        InvoiceLine[]
  payments     Payment[]
  refunds      Refund[]
  claims       Claim[]
  paymentLinks PaymentLink[]
  dispense     Dispense?
  labOrder     LabOrder?

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNo])
  @@unique([tenantId, appointmentId])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, patientId])
  @@map("invoices")
  @@schema("hms")
}

model InvoiceLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  kind        LineKind
  description String
  quantity    Int      @default(1)
  unitPaise   Int      @map("unit_paise")
  amountPaise Int      @map("amount_paise")
  gstPercent  Int      @default(0) @map("gst_percent")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
  @@schema("hms")
}

model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amountPaise Int           @map("amount_paise")
  method      PaymentMethod
  reference   String?
  // Id from the payment gateway; makes webhook deliveries idempotent.
  externalId  String?       @map("external_id")
  receivedBy  String?       @map("received_by") @db.Uuid
  receivedAt  DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@unique([tenantId, externalId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, invoiceId])
  @@map("payments")
  @@schema("hms")
}

// End-of-day cash reconciliation: what the system expected versus what was counted.
model DailyClosing {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  date                DateTime @db.Date
  expectedCashPaise   Int      @map("expected_cash_paise")
  countedCashPaise    Int      @map("counted_cash_paise")
  totalCollectedPaise Int      @map("total_collected_paise")
  notes               String?
  closedBy            String?  @map("closed_by") @db.Uuid
  closedAt            DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, branchId, date])
  @@map("daily_closings")
  @@schema("hms")
}

// ───────────── hms: clinical (consultation + prescription) ─────────────

model Consultation {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  doctorId      String?   @map("doctor_id") @db.Uuid
  complaints    String?
  // { bpSystolic, bpDiastolic, pulse, tempC, spo2, weightKg, heightCm }, validated in the API.
  vitals        Json?
  diagnosis     String?
  advice        String?
  followUpOn    DateTime? @map("follow_up_on") @db.Date
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  // Assigned when the doctor signs off. rxCode lets anyone (a pharmacy, an insurer) confirm a printout is genuine.
  rxNo          String?   @map("rx_no")
  rxCode        String?   @unique @map("rx_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  documents   PatientDocument[]
  appointment Appointment        @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  patient     Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id])
  doctor      Identity?          @relation(fields: [doctorId], references: [id])
  items       PrescriptionItem[]
  dispenses   Dispense[]
  labOrders   LabOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@unique([tenantId, rxNo])
  @@index([tenantId, patientId, createdAt])
  @@map("consultations")
  @@schema("hms")
}

model PrescriptionItem {
