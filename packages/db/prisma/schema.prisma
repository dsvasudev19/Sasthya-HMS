// ───────────── hms: messaging ─────────────

enum MessageChannel {
  SMS
  WHATSAPP

  @@schema("hms")
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED

  @@schema("hms")
}

// Outbox: messages are queued in the same transaction as the event that caused them, then delivered by the worker.
model Message {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  patientId     String?        @map("patient_id") @db.Uuid
  channel       MessageChannel @default(SMS)
  toPhone       String         @map("to_phone")
  template      String
  language      String         @default("en")
  body          String
  status        MessageStatus  @default(QUEUED)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  providerRef   String?        @map("provider_ref")
  error         String?
  // Makes scheduling idempotent: the same reminder is never queued twice.
  dedupeKey     String         @map("dedupe_key")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  patient Patient? @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("messages")
  @@schema("hms")
}

model TenantSetting {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_settings")
  @@schema("hms")
}

// ───────────── platform: SaaS billing and admin ─────────────

enum PlatformInvoiceStatus {
  DUE
  PAID
  VOID

  @@schema("platform")
}

model PlatformAdmin {
  identityId String   @id @map("identity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id])

  @@map("platform_admins")
  @@schema("platform")
}

// What we charge a hospital: subscription or per-patient fees, message overage, plus 18% GST.
model PlatformInvoice {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  invoiceNo      String                @unique @map("invoice_no")
  periodStart    DateTime              @map("period_start") @db.Date
  periodEnd      DateTime              @map("period_end") @db.Date
  planCode       PlanCode              @map("plan_code")
  lines          Json
  subtotalPaise  Int                   @map("subtotal_paise")
  gstPaise       Int                   @map("gst_paise")
  totalPaise     Int                   @map("total_paise")
  status         PlatformInvoiceStatus @default(DUE)
  dueDate        DateTime              @map("due_date") @db.Date
  paidAt         DateTime?             @map("paid_at") @db.Timestamptz(3)
  paymentRef     String?               @map("payment_ref")
  // Razorpay payment link created for this invoice, if the owner chose to pay online.
  gatewayRef     String?               @map("gateway_ref")
  paymentLinkUrl String?               @map("payment_link_url")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, periodStart])
  @@index([status, dueDate])
  @@map("platform_invoices")
  @@schema("platform")
}

// Rotating refresh tokens for web sessions. Only a hash is stored; reuse of an old token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  role       String?
  kind       String    @default("staff")
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id])

  @@index([familyId])
  @@index([identityId])
  @@map("refresh_tokens")
  @@schema("platform")
}

// ───────────── hms: refunds and online payment links ─────────────

// Append-only: a refund is never edited or removed.
model Refund {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amountPaise Int           @map("amount_paise")
  method      PaymentMethod
  reason      String
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceId])
  @@map("refunds")
  @@schema("hms")
}

enum PaymentLinkStatus {
  CREATED
  PAID
  EXPIRED

  @@schema("hms")
}

model PaymentLink {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  invoiceId   String            @map("invoice_id") @db.Uuid
  gatewayRef  String            @map("gateway_ref")
  url         String
  amountPaise Int               @map("amount_paise")
  status      PaymentLinkStatus @default(CREATED)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@unique([tenantId, gatewayRef])
  @@index([tenantId, invoiceId])
  @@map("payment_links")
  @@schema("hms")
}

// ───────────── platform: dynamic access control ─────────────

// A role the hospital defines: a named set of permissions. System roles (OWNER, ADMIN, ...) ship with defaults.
model TenantRole {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  // A system role stays in step with the product's defaults until someone edits it.
  customized  Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  memberships TenantMembership[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("tenant_roles")
  @@schema("platform")
}

// Attribute-based rules on top of roles: "deny refunds above Rs 2,000 unless owner", "no writes outside 6 am to 10 pm".
model TenantPolicy {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  enabled        Boolean   @default(true)
  // Permission key, a prefix such as "billing:*", or "*".
  permission     String
  // Role keys the rule applies to; empty means everyone.
  appliesToRoles String[]  @map("applies_to_roles")
  // [{ attr, op, value }]: the rule fires when all (match ALL) or any (match ANY) of the conditions are true.
  conditions     Json
  match          String    @default("ALL")
  // Roles the rule never applies to, so "everyone except the owner" can be said directly.
  exceptRoles    String[]  @default([]) @map("except_roles")
  // The rule only runs inside this window (a festival week, a stock-take month); either end may be open.
  validFrom      DateTime? @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  description    String?
  message        String
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, enabled])
  @@map("tenant_policies")
  @@schema("platform")
}

// Which branches a staff member can work in. Staff with the "branches:all" permission are not limited.
model StaffBranch {
  tenantId   String @map("tenant_id") @db.Uuid
  identityId String @map("identity_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  identity Identity @relation(fields: [identityId], references: [id])
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@id([tenantId, identityId, branchId])
  @@map("staff_branches")
  @@schema("platform")
}

// ───────────── hms: branches, doctors ─────────────

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
