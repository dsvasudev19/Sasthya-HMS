  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  batches            StockBatch[]
  movements          StockMovement[]
  prescriptions      PrescriptionItem[]
  dispenseLines      DispenseLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, name, strength])
  @@unique([tenantId, barcode])
  @@map("medicines")
  @@schema("hms")
}

model StockBatch {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  medicineId  String   @map("medicine_id") @db.Uuid
  batchNo     String   @map("batch_no")
  expiryDate  DateTime @map("expiry_date") @db.Date
  qtyReceived Int      @map("qty_received")
  qtyOnHand   Int      @map("qty_on_hand")
  costPaise   Int?     @map("cost_paise")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  branch            Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id])
  medicine          Medicine           @relation(fields: [tenantId, medicineId], references: [tenantId, id])
  movements         StockMovement[]
  dispenseLines     DispenseLine[]
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, medicineId, batchNo])
  @@index([tenantId, branchId, medicineId, expiryDate])
  @@map("stock_batches")
  @@schema("hms")
}

// Append-only stock ledger: every change to a batch has a row here.
model StockMovement {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  branchId   String        @map("branch_id") @db.Uuid
  medicineId String        @map("medicine_id") @db.Uuid
  batchId    String        @map("batch_id") @db.Uuid
  type       StockMoveType
  qty        Int
  refType    String?       @map("ref_type")
  refId      String?       @map("ref_id")
  note       String?
  createdBy  String?       @map("created_by") @db.Uuid
