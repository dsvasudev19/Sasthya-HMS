# App role (DML only, no BYPASSRLS). Copy the DATABASE_URL line from packages/db/.env after `pnpm db:bootstrap`.
DATABASE_URL="postgresql://hms_app:CHANGE_ME@localhost:5432/swasthya_hms"
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082
# 32+ random characters; generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_32_PLUS
MESSAGING_PROVIDER=console
# MESSAGING_WEBHOOK_URL=
# MESSAGING_WEBHOOK_TOKEN=
# Optional online payments (Razorpay payment links). Leave empty to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Patient documents: encrypted at rest. REQUIRED in production. Generate with: openssl rand -hex 32
# DOCUMENTS_KEY=
# DOCUMENTS_DIR=./data/documents
# Tele-consultation video. Default is the public Jitsi service; point at a self-hosted Jitsi for production.
# TELE_BASE_URL=https://meet.jit.si
# TELE_JWT_APP_ID=
# TELE_JWT_SECRET=
